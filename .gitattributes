# The landing site is generated and byte-compared by scripts/site/build_site.mjs
# --check. A CRLF checkout would report a current tree as stale.
docs/ecp-landing/** text eol=lf
scripts/site/** text eol=lf

# ...except the binaries under them. `text eol=lf` on a PNG rewrites every
# 0x0d 0x0a pair in the image data and corrupts it — verified: the committed
# og.png came back as "improper image header".
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff binary
*.woff2 binary

# Stored-data fixtures are byte-exact: a CRLF checkout changes their content
# hashes and the SHA of the repository the tests rebuild from them.
crates/ecp-cli/tests/fixtures/stored-by-0.16.4/** -text
crates/ecp-cli/tests/fixtures/stored-commits-by-0.16.4/** -text
